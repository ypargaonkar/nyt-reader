# NYT Reader Environment Variables
# Copy this file to .env.local and fill in your API keys

# New York Times API Key
# Get yours at: https://developer.nytimes.com
NYT_API_KEY=your_nyt_api_key_here

# OpenAI API Key (for AI-powered preference analysis)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# App Password (protects your reader from public access)
# Set this to any password you want to use
APP_PASSWORD=your_password_here

# App Secret (used for token generation - can be any random string)
APP_SECRET=your_random_secret_here

# Turso Database (for cloud data sync - required for Vercel deployment)
# Get yours at: https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
